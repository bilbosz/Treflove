local MenuEntry: MenuEntry = require("ui.menu.menu-entry")
local Control: Control = require("controls.control")
local Consts = require("app.consts")
local TextButton: TextButton = require("ui.text-button")

-- A menu entry that is a centred text button.
local MenuTextButton: MenuTextButton = class("MenuTextButton", MenuEntry)

MenuTextButton.init = function(self: MenuTextButton, screen: MenuScreen, label: string, cb: TextButtonAction)
    MenuEntry.init(self)
    self._screen = screen
    self._label = label
    self._cb = cb
end

function MenuTextButton:create_control(parent: Control): Control
    local ctrl = Control(parent)
    self.control = ctrl
    ctrl:set_scale(Consts.MENU_BUTTON_SCALE)

    local text = TextButton(ctrl, self._screen, self._label, self._cb)
    local w = text:get_size()
    text:set_origin(w * 0.5, 0)

    return ctrl
end

return MenuTextButton
