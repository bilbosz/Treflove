      getJoints: function(self): {any:any}
      getLinearDamping: function(self): number
      getLinearVelocity: function(self): (number, number)
      getLinearVelocityFromLocalPoint: function(self, x: number, y: number): (number, number)
      getLinearVelocityFromWorldPoint: function(self, x: number, y: number): (number, number)
      getLocalCenter: function(self): (number, number)
      getLocalPoint: function(self, worldX: number, worldY: number): (number, number)
      getLocalPoints: function(self, x1: number, y1: number, x2: number, y2: number, ...: number): (number, number, number, number, number...)
      getLocalVector: function(self, worldX: number, worldY: number): (number, number)
      getMass: function(self): number
      getMassData: function(self): (number, number, number, number)
      getPosition: function(self): (number, number)
      getTransform: function(self): (number, number, number)
      getType: function(self): BodyType
      getUserData: function(self): any
      getWorld: function(self): World
      getWorldCenter: function(self): (number, number)
      getWorldPoint: function(self, localX: number, localY: number): (number, number)
      getWorldPoints: function(self, x1: number, y1: number, x2: number, y2: number): (number, number, number, number)
      getWorldVector: function(self, localX: number, localY: number): (number, number)
      getX: function(self): number
      getY: function(self): number
      isActive: function(self): boolean
      isAwake: function(self): boolean
      isBullet: function(self): boolean
      isDestroyed: function(self): boolean
      isFixedRotation: function(self): boolean
      isSleepingAllowed: function(self): boolean
      isTouching: function(self, otherbody: Body): boolean
      resetMassData: function(self)
      setActive: function(self, active: boolean)
      setAngle: function(self, angle: number)
      setAngularDamping: function(self, damping: number)
      setAngularVelocity: function(self, w: number)
      setAwake: function(self, awake: boolean)
      setBullet: function(self, status: boolean)
      setFixedRotation: function(self, isFixed: boolean)
      setGravityScale: function(self, scale: number)
      setInertia: function(self, inertia: number)
      setLinearDamping: function(self, ld: number)
      setLinearVelocity: function(self, x: number, y: number)
      setMass: function(self, mass: number)
      setMassData: function(self, x: number, y: number, mass: number, inertia: number)
      setPosition: function(self, x: number, y: number)
      setSleepingAllowed: function(self, allowed: boolean)
      setTransform: function(self, x: number, y: number, angle: number)
      setType: function(self, type: BodyType)
      setUserData: function(self, value: any)
      setX: function(self, x: number)
      setY: function(self, y: number)
   end
   interface ChainShape is Shape, Object
      getChildEdge: function(self, index: number): EdgeShape
      getNextVertex: function(self): (number, number)
      getPoint: function(self, index: number): (number, number)
      getPoints: function(self): (number, number, number, number)
      getPreviousVertex: function(self): (number, number)
      getVertexCount: function(self): number
      setNextVertex: function(self, x: number, y: number)
      setPreviousVertex: function(self, x: number, y: number)
   end
   interface CircleShape is Shape, Object
      getPoint: function(self): (number, number)
      getRadius: function(self): number
      setPoint: function(self, x: number, y: number)
      setRadius: function(self, radius: number)
   end
   interface Contact is Object
      getChildren: function(self): (number, number)
      getFixtures: function(self): (Fixture, Fixture)
      getFriction: function(self): number
      getNormal: function(self): (number, number)
      getPositions: function(self): (number, number, number, number)
      getRestitution: function(self): number
      isEnabled: function(self): boolean
      isTouching: function(self): boolean
      resetFriction: function(self)
      resetRestitution: function(self)
      setEnabled: function(self, enabled: boolean)
      setFriction: function(self, friction: number)
      setRestitution: function(self, restitution: number)
   end
   interface DistanceJoint is Joint, Object
      getDampingRatio: function(self): number
      getFrequency: function(self): number
      getLength: function(self): number
      setDampingRatio: function(self, ratio: number)
      setFrequency: function(self, Hz: number)
      setLength: function(self, l: number)
   end
   interface EdgeShape is Shape, Object
      getNextVertex: function(self): (number, number)
      getPoints: function(self): (number, number, number, number)
      getPreviousVertex: function(self): (number, number)
      setNextVertex: function(self, x: number, y: number)
      setPreviousVertex: function(self, x: number, y: number)
   end
   interface Fixture is Object
      destroy: function(self)
      getBody: function(self): Body
      getBoundingBox: function(self, index?: number): (number, number, number, number)
      getCategory: function(self): number...
      getDensity: function(self): number
      getFilterData: function(self): (number, number, number)
      getFriction: function(self): number
      getGroupIndex: function(self): number
      getMask: function(self): number...
      getMassData: function(self): (number, number, number, number)
      getRestitution: function(self): number
      getShape: function(self): Shape
      getUserData: function(self): any
      isDestroyed: function(self): boolean
      isSensor: function(self): boolean
      rayCast: function(self, x1: number, y1: number, x2: number, y2: number, maxFraction: number, childIndex?: number): (number, number, number)
      setCategory: function(self, ...: number)
      setDensity: function(self, density: number)
      setFilterData: function(self, categories: number, mask: number, group: number)
      setFriction: function(self, friction: number)
      setGroupIndex: function(self, group: number)
      setMask: function(self, ...: number)
      setRestitution: function(self, restitution: number)
      setSensor: function(self, sensor: boolean)
      setUserData: function(self, value: any)
      testPoint: function(self, x: number, y: number): boolean
   end
   interface FrictionJoint is Joint, Object
