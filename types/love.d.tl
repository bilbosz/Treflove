   interface World is Object
      destroy: function(self)
      getBodies: function(self): {any:any}
      getBodyCount: function(self): number
      getCallbacks: function(self): (function(...: any): any..., function(...: any): any..., function(...: any): any..., function(...: any): any...)
      getContactCount: function(self): number
      getContactFilter: function(self): function(...: any): any...
      getContacts: function(self): {any:any}
      getGravity: function(self): (number, number)
      getJointCount: function(self): number
      getJoints: function(self): {any:any}
      isDestroyed: function(self): boolean
      isLocked: function(self): boolean
      isSleepingAllowed: function(self): boolean
      queryBoundingBox: function(self, topLeftX: number, topLeftY: number, bottomRightX: number, bottomRightY: number, callback: function(...: any): any...)
      rayCast: function(self, x1: number, y1: number, x2: number, y2: number, callback: function(...: any): any...)
      setCallbacks: function(self, beginContact: function(...: any): any..., endContact: function(...: any): any..., preSolve?: function(...: any): any..., postSolve?: function(...: any): any...)
      setContactFilter: function(self, filter: function(...: any): any...)
      setGravity: function(self, x: number, y: number)
      setSleepingAllowed: function(self, allow: boolean)
      translateOrigin: function(self, x: number, y: number)
      update: function(self, dt: number, velocityiterations?: number, positioniterations?: number)
   end
   interface Decoder is Object
      clone: function(self): Decoder
      decode: function(self): SoundData
      getBitDepth: function(self): number
      getChannelCount: function(self): number
      getDuration: function(self): number
      getSampleRate: function(self): number
      seek: function(self, offset: number)
   end
   interface SoundData is Data, Object
      getBitDepth: function(self): number
      getChannelCount: function(self): number
      getDuration: function(self): number
      getSample: function(self, i: number): number
      getSample: function(self, i: number, channel: number): number
      getSampleCount: function(self): number
      getSampleRate: function(self): number
      setSample: function(self, i: number, sample: number)
      setSample: function(self, i: number, channel: number, sample: number)
   end
   interface Channel is Object
      clear: function(self)
      demand: function(self): any
      demand: function(self, timeout: number): any
      getCount: function(self): number
      hasRead: function(self, id: number): boolean
      peek: function(self): any
      performAtomic: function(self, func: function(...: any): any..., ...: any): (any, any...)
      pop: function(self): any
      push: function(self, value: any): number
      supply: function(self, value: any): boolean
      supply: function(self, value: any, timeout: number): boolean
   end
   interface Thread is Object
      getError: function(self): string
      isRunning: function(self): boolean
      start: function(self)
      start: function(self, ...: any)
      wait: function(self)
   end
