local Consts = require("app.consts")

-- A file under the assets root of the running side (server or client), on
-- LÖVE's filesystem.
local Asset: Asset = class("Asset")

local function _create_intermediate_dirs(path: string)
    local found: integer = 0
    while true do
        found = string.find(path, "/", found + 1)
        if not found then
            break
        end
        local dir = string.sub(path, 1, found - 1)
        local info = love.filesystem.getInfo(dir)
        if not info then
            assert(love.filesystem.createDirectory(dir))
        else
            assert(info.type == "directory")
        end
    end
end

function Asset.get_asset_path(virtual_path: string): string
    return (app.is_server and Consts.ASSETS_SERVER_ROOT or Consts.ASSETS_CLIENT_ROOT) .. "/assets/" .. virtual_path
end

function Asset.get_root_path(virtual_path: string): string
    return (app.is_server and Consts.ASSETS_SERVER_ROOT or Consts.ASSETS_CLIENT_ROOT) .. "/" .. virtual_path
end

Asset.init = function(self: Asset, path: string, is_on_root: boolean)
    assert(string.sub(path, 1, 1) ~= "/")
    self._path = is_on_root and Asset.get_root_path(path) or Asset.get_asset_path(path)
end

function Asset:create()
    _create_intermediate_dirs(self._path)
    assert(love.filesystem.write(self._path, ""))
end

function Asset:write(content: string)
    assert(love.filesystem.write(self._path, content))
end

function Asset:read(): string
    return (love.filesystem.read(self._path))
end

function Asset:get_type(): love.FileType
    local info = love.filesystem.getInfo(self._path)
    -- as: getInfo's result is a love-api "table" ({any: any}); its `type`
    -- is a FileType.
    return info and info.type as love.FileType
end

function Asset:get_size(): number
    local info = love.filesystem.getInfo(self._path)
    -- as: see get_type; `size` is a number.
    return info and info.size as number
end

function Asset:get_path(): string
    local info = love.filesystem.getInfo(self._path)
    return info and self._path
end

return Asset
