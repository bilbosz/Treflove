# https://github.com/Koihik/LuaFormatter
# The config of ./format-code.sh and the koihik.vscode-lua-format extension,
# for the Lua files only (lua-format does not read Teal). lua-lifetime's
# .lua-format is a copy.
column_limit: 200
keep_simple_control_block_one_line: false
keep_simple_function_one_line: false
chop_down_table: false
chop_down_kv_table: false
column_table_limit: 1
single_quote_to_double_quote: true
