-- The server's dispatcher thread, started by the Connector: accepts every
-- client on the server's port, starts a server-in for it and tells the
-- client the port server-in bound.
-- as: a thread's arguments are what Thread:start passed (Connector);
-- Teal types a main chunk's `...` as strings.
local logger_data, channel, address, port = ... as (ModelData, love.Channel, string, string)

-- A thread has a Lua state of its own: load love.filesystem (its module
-- searcher) and look in build/ first, as main.lua does.
require("love.filesystem")
love.filesystem.setRequirePath("build/?.lua;build/?/init.lua;?.lua;?/init.lua")

local Socket = require("socket")
local Logger = require("utils.logger")
local logger = Logger(logger_data, "connection-dispatcher")

local server, bind_err = Socket.bind(address, tonumber(port))
assert(not bind_err, bind_err)
logger:log("Connection dispatcher started working")

while true do
    logger:log("Waiting for connection...")

    local client = server:accept()
    logger:log("New client found")

    local dispatcher_channel = love.thread.newChannel()
    local in_thread = love.thread.newThread("build/networking/detail/server-in.lua")
    in_thread:start(logger_data, address, dispatcher_channel, channel, in_thread)

    -- as: server-in pushes the port it bound, or false when it failed.
    local in_port = dispatcher_channel:demand() as integer | boolean
    if in_port then
        local in_port_string = tostring(in_port)
        logger:log("Received receiver port " .. in_port_string)
        client:send(in_port_string .. "\n")
    else
        logger:log("Server input port not received")
        in_thread:release()
    end
    dispatcher_channel:release()

    client:close()
    -- as: known fault (TODO.md): when server-in failed, in_port is false
    -- and the concatenation raises, ending the dispatcher.
    logger:log("Dispatcher connection closed for client with port " .. (in_port as integer))
end
