{
    "workspace": {
        "library": [
            "annotations/love2d/library",
            "annotations/luasocket/library",
            "lib/lua-lifetime/editor/luals/meta"
        ],
        "ignoreDir": [
            "/lib"
        ]
    },
    "runtime.version": "LuaJIT",
    "runtime.special": {
        "love.filesystem.load": "loadfile"
    },
    "workspace.checkThirdParty": false,
    "diagnostics.globals": [
        "abstract",
        "app",
        "assert_type",
        "assert_unreachable",
        "cipairs",
        "class",
        "config",
        "cpairs",
        "cripairs",
        "dump",
        "get_class_name_of",
        "get_class_of",
        "is_instance_of",
        "lifetime_destroyerror",
        "prev",
        "ripairs",
        "toboolean"
    ],
    "diagnostics.disable": [],
    "runtime.plugin": ".vscode/constructor_hints.lua",
    "diagnostics.neededFileStatus": {
        "no-unknown": "Any",
        "incomplete-signature-doc": "Any",
        "missing-global-doc": "Any",
        "missing-local-export-doc": "Any",
        "global-element": "Any",
        "lowercase-global": "Any"
    },
    "diagnostics.severity": {
        "no-unknown": "Warning",
        "incomplete-signature-doc": "Warning",
        "missing-global-doc": "Warning",
        "missing-local-export-doc": "Warning",
        "global-element": "Warning",
        "lowercase-global": "Warning"
    },
    "type.checkTableShape": true,
    "runtime.builtin": {
        "utf8": "enable"
    }
}
