local Consts = require("app.consts")
local Panel: Panel = require("ui.panel")
local PreviewArea: PreviewArea = require("game.assets.preview-area.preview-area")
local PreviewAudioArea: PreviewAudioArea = require("game.assets.preview-area.preview-audio-area")
local PreviewImageArea: PreviewImageArea = require("game.assets.preview-area.preview-image-area")
local Text: Text = require("controls.text")
local TextButton: TextButton = require("ui.text-button")
local TextInput: TextInput = require("ui.text-input")
local Utils = require("utils.utils")
local media = require("utils.media")

-- Previews a dropped file and uploads it to the server.
local AssetsPanel: AssetsPanel = class("AssetsPanel", Panel)

-- The preview class by media type (class tables, typed by what both
-- instances have in common: game/assets/preview-area/preview-area.d.tl).
local FILE_TYPE_PREVIEW: {Media.Type: PreviewComponent} = {
    IMAGE = PreviewImageArea,
    AUDIO = PreviewAudioArea,
    VIDEO = nil,
    TEXT = nil,
    FONT = nil
}

-- The area belongs to the panel (lua-lifetime docs/02-semantics.md,
-- "Cascading death"): its release, which undoes its drop registration,
-- runs when the panel dies, and the panel's game screen owns the panel.
-- The panel's children keep it referenced, so the implicit `reachable`
-- term does not end it early.
local function _create_preview_area(self: AssetsPanel)
    local w = self:get_size() - 2 * Consts.PADDING
    self._preview_area = PreviewArea(self, w, w) @ self
    self._preview_area:set_position(Consts.PADDING, Consts.PADDING)
end

local function _create_location_label(self: AssetsPanel): Text
    local text = Text(self, "Local path", Consts.FOREGROUND_COLOR)
    local _, area_y, _, area_h = self._preview_area:get_position_and_size()

    text:set_position(Consts.PADDING, area_y + area_h + Consts.PADDING)
    text:set_scale(Consts.PANEL_FIELD_SCALE)
    return text
end

local function _create_location_input(self: AssetsPanel): TextInput
    local panel_w = self:get_size()
    local input = TextInput(self, self._game_screen, panel_w - 2 * Consts.PADDING, Consts.PANEL_TEXT_INPUT_HEIGHT)
    self._location_input = input

    input:set_read_only(true)
    return input
end

local function _create_location_field(self: AssetsPanel)
    local text = _create_location_label(self)
    local text_x, text_y, _, text_h = text:get_position_and_outer_size()

    local input = _create_location_input(self)
    input:set_position(text_x, text_y + text_h + Consts.PADDING)
end

local function _create_file_type_label(self: AssetsPanel): Text
    local text = Text(self, "File type", Consts.FOREGROUND_COLOR)
    local _, input_y, _, input_h = self._location_input:get_position_and_size()

    text:set_position(Consts.PADDING, input_y + input_h + Consts.PADDING)
    text:set_scale(Consts.PANEL_FIELD_SCALE)
    return text
end

local function _create_file_type_input(self: AssetsPanel): TextInput
    local panel_w = self:get_size()
    local input = TextInput(self, self._game_screen, panel_w - 2 * Consts.PADDING, Consts.PANEL_TEXT_INPUT_HEIGHT)
    self._file_type_input = input

    input:set_read_only(true)
    return input
end

local function _create_file_type_field(self: AssetsPanel)
    local text = _create_file_type_label(self)
    local text_x, text_y, _, text_h = text:get_position_and_outer_size()
    local input = _create_file_type_input(self)
    input:set_position(text_x, text_y + text_h + Consts.PADDING)
end

local function _create_remote_location_label(self: AssetsPanel): Text
    local text = Text(self, "Remote location", Consts.FOREGROUND_COLOR)
    local _, input_y, _, input_h = self._file_type_input:get_position_and_size()

    text:set_position(Consts.PADDING, input_y + input_h + Consts.PADDING)
    text:set_scale(Consts.PANEL_FIELD_SCALE)
    return text
end

local function _create_remote_location_input(self: AssetsPanel): TextInput
    local panel_w = self:get_size()
    local input = TextInput(self, self._game_screen, panel_w - 2 * Consts.PADDING, Consts.PANEL_TEXT_INPUT_HEIGHT)
    self._remote_location_input = input

    input:set_read_only(true)
    return input
end

local function _create_remote_location_field(self: AssetsPanel)
    local text = _create_remote_location_label(self)
    local text_x, text_y, _, text_h = text:get_position_and_outer_size()
    local input = _create_remote_location_input(self)
    input:set_position(text_x, text_y + text_h + Consts.PADDING)
end

local function _refresh_upload_button_geometry(self: AssetsPanel)
    local w, h = self:get_size()
    local button = self._upload_button
    local s = Consts.PANEL_FIELD_SCALE
    button:set_scale(s)

    local button_w, button_h = button:get_size()
    button:set_position(w - button_w * s - Consts.PADDING, h - button_h * s - Consts.PADDING)
end

local function _refresh_cancel_button_geometry(self: AssetsPanel)
    local _, h = self:get_size()
    local button = self._cancel_button
    local s = Consts.PANEL_FIELD_SCALE
    button:set_scale(s)

    local _, button_h = button:get_size()
    button:set_position(Consts.PADDING, h - button_h * s - Consts.PADDING)
end

local function _create_upload_button(self: AssetsPanel)
    local button = TextButton(self, self._game_screen, "Upload", function()
        self:_upload()
    end)
    self._upload_button = button

    _refresh_upload_button_geometry(self)
end

local function _create_cancel_button(self: AssetsPanel)
    local button = TextButton(self, self._game_screen, "Cancel", function()
        self:cancel()
    end)
    self._cancel_button = button

    _refresh_cancel_button_geometry(self)
end

local function _refresh_action_buttons(self: AssetsPanel)
    _refresh_upload_button_geometry(self)
    _refresh_cancel_button_geometry(self)
end

local function _set_file_type(self: AssetsPanel, data: string)
    local media_type, medium = media.get_type_and_medium(data)
    self._media_type = media_type
    local file_type_preview = FILE_TYPE_PREVIEW[media_type]
    if file_type_preview then
        self._preview_area:set_content(medium, file_type_preview)
    end
    self._file_type_input:set_text(tostring(media_type))
end

AssetsPanel.init = function(self: AssetsPanel, game_screen: GameScreen, width: number, height: number)
    Panel.init(self, game_screen:get_control(), width, height)
    self._game_screen = game_screen
    self._media_type = nil
    self._data = nil
    self._data_size = nil
    _create_preview_area(self)
    _create_location_field(self)
    _create_file_type_field(self)
    _create_remote_location_field(self)
    _create_cancel_button(self)
    _create_upload_button(self)
end

function AssetsPanel:set_file(file: love.DroppedFile)
    -- as: LÖVE returns a love.FileData for the "data" container; every
    -- consumer (media.get_type_and_medium, love.data.encode in
    -- AssetManager:upload_asset) takes it where it takes a string.
    local data = file:read("data") as string
    local size = file:getSize()
    self._data = data
    self._data_size = size
    _set_file_type(self, data)

    local path = file:getFilename()
    self._location_input:set_text(path)
    local split_path = Utils.split_path(path)

    local file_name = split_path[#split_path]
    self._remote_location_input:set_text(file_name)
    self._remote_location_input:set_read_only(false)
end

function AssetsPanel:on_resize(w: number, h: number)
    Panel.on_resize(self, w, h)
    _refresh_action_buttons(self)
end

function AssetsPanel:reset()
    self._preview_area:reset()
    self._location_input:set_text("")
    self._file_type_input:set_text("")
    self._remote_location_input:set_read_only(true)
    self._remote_location_input:set_text("")
    self._media_type = nil
    self._data = nil
    self._data_size = nil
end

function AssetsPanel:_upload()
    if self._data then
        app.asset_manager:upload_asset(self._remote_location_input:get_text(), self._data)
    end
end

function AssetsPanel:cancel()
    self:reset()
end

return AssetsPanel
