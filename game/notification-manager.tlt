local Consts = require("app.consts")
local NotificationPanel: NotificationPanel = require("panels.notification-panel")

-- Timed notifications, drawn by the NotificationPanel.
local NotificationManager: NotificationManager = class("NotificationManager")

NotificationManager.init = function(self: NotificationManager)
    self._panel = NotificationPanel()
    self._notifications = {}
    app.update_event:register(self, self.on_update)
end

function NotificationManager:notify(message: string, duration?: number)
    table.insert(self._notifications, {
        message = message,
        start_time = app:get_time(),
        duration = duration or Consts.NOTIFICATION_DURATION
    })
    self._panel:update_notifications()
end

-- Internal to the notification subsystem: used by NotificationPanel.
function NotificationManager:_get_notifications(): {Notification}
    return self._notifications
end

function NotificationManager:clear_notifications()
    self._notifications = {}
    self._panel:update_notifications()
end

function NotificationManager:on_update()
    local time = app:get_time()
    local to_remove: {integer}
    for i, notification in ipairs(self._notifications) do
        if time > notification.start_time + notification.duration then
            to_remove = to_remove or {}
            table.insert(to_remove, i)
        end
    end
    if to_remove then
        for _, i in ripairs(to_remove) do
            table.remove(self._notifications, i)
        end
        self._panel:update_notifications()
    end
end

return NotificationManager
