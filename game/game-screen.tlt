local AssetsPanel: AssetsPanel = require("game.assets.assets-panel")
local Consts = require("app.consts")
local FormScreen: FormScreen = require("ui.form-screen")
local Model: Model = require("data.model")
local Page: Page = require("game.page.page")
local QuickAccessPanel: QuickAccessPanel = require("game.quick-access-panel")
local TokenPanel: TokenPanel = require("game.token.token-panel")
local UserMenuScreen: UserMenuScreen = require("screens.user-menu-screen")
local table_utils = require("utils.table")

-- The game view: the page, the side panels and the quick-access bar. Made
-- and owned by the session's GameDataRp (`GameScreen(...) @ self`), and
-- destroyed by its own back entry once the user menu is shown again
-- (docs/lifetime.md, "Screens").
local GameScreen: GameScreen = class("GameScreen", Model, FormScreen)

GameScreen.init = function(self: GameScreen, data: GameScreenData)
    Model.init(self, data)
    FormScreen.init(self)

    self._page = Page(app.data.pages[data.page], self, app.width * 0.8, app.height)

    self._token_panel = TokenPanel(self, app.width * 0.2, app.height)
    -- Owned (lua-lifetime docs/02-semantics.md, "Cascading death"): the
    -- panel's preview area undoes its drop registration in its release,
    -- which runs when the screen dies, after the screen's own release.
    self._assets_panel = AssetsPanel(self, app.width * 0.2, app.height) @ self

    self._panel = self._assets_panel
    local panels: {Panel} = {
        self._token_panel,
        self._assets_panel
    }
    self._panels = panels
    for _, v in ipairs(panels) do
        if v ~= self._panel then
            v:set_enabled(false)
        end
    end

    self._quick_access_panel = QuickAccessPanel(self, app.width * 0.8, Consts.QUICK_ACCESS_PANEL_HEIGHT)
    self._quick_access_panel:add_entry("Tokens", self._token_panel)
    self._quick_access_panel:add_entry("Assets", self._assets_panel)
end

-- The back entry returns to the user menu, then destroys the screen: a
-- screen dies only after it has been replaced (docs/lifetime.md,
-- "Screens"), and the one destroy ends the screen's release, then what it
-- owns ("Cascading death"). The entry is anchored to the screen, so a
-- screen that dies otherwise (with its session, on a disconnect) takes
-- its entry off the back stack ("Back Navigation"); `back()` destroys the
-- entry before running it.
function GameScreen:show()
    self:on_resize(app.width, app.height)
    FormScreen.show(self)
    app.backstack_manager:push(function()
        app.screen_manager:show(UserMenuScreen(app.session))
        lifetime.destroy(self)
    end) @ self
end

function GameScreen:on_selection_change()
    self._token_panel:on_selection_change()
end

function GameScreen:on_resize(w: number, h: number)
    self._page:set_position(0, Consts.QUICK_ACCESS_PANEL_HEIGHT)
    self._page:set_size(w * 0.8, h - Consts.QUICK_ACCESS_PANEL_HEIGHT)

    self._quick_access_panel:set_position(0, 0)
    self._quick_access_panel:on_resize(w * 0.8, Consts.QUICK_ACCESS_PANEL_HEIGHT)

    self._token_panel:set_position(w * 0.8, 0)
    self._token_panel:on_resize(w * 0.2, h)

    self._assets_panel:set_position(w * 0.8, 0)
    self._assets_panel:on_resize(w * 0.2, h)
end

function GameScreen:get_page(): Page
    return self._page
end

function GameScreen:get_selection(): Selection
    return self._page:get_selection()
end

function GameScreen:get_token_panel(): TokenPanel
    return self._token_panel
end

function GameScreen:select_panel(panel: Panel)
    assert(table_utils.find_array_idx(self._panels, panel))
    self:disable_panel()
    self._panel = panel
    panel:set_enabled(true)
end

function GameScreen:disable_panel()
    if self._panel then
        self._panel:set_enabled(false)
        self._panel = nil
    end
end

return GameScreen
