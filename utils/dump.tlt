-- any (throughout): the dumper renders values of every type.
local type DumpNodeDisplay = function(value: any, type: string, global_name: string, content: string): string

local record DumpDisplayConfig
    show_global_names: boolean
    table_max_level: number
    table_indention: string
    table_unfold_repeated: boolean
    table_newline: string
    index_display: DumpNodeDisplay
    key_display: DumpNodeDisplay
    value_display: DumpNodeDisplay
    separator: string
end

local record DumpStacktraceConfig
end

local record DumpConfig
    keyword: string
    stacktrace: DumpStacktraceConfig
    dump: DumpDisplayConfig
    text_processor: function(text: string): any -- any: e.g. `print`'s nothing
end

local type Dumper = function(...: any): any

local function _dump_generator(dumper_config: DumpConfig): Dumper
    if not dumper_config then
        return
    end

    local function create_keyword(keyword: string): string
        return "[" .. keyword .. "]\n"
    end

    local function create_stacktrace(_stacktrace_config: DumpStacktraceConfig): string
        local result = "\n[STACKTRACE]\n"
        local trace = debug.traceback()
        local line_no = 1
        local ignore_head = 3
        local found: integer = 0
        while found do
            local prev_found = found
            found = string.find(trace, "\n", found + 1)
            local line = string.sub(trace, prev_found + 1, found)
            if line_no > ignore_head and not string.find(line, "boot%.lua") and not string.find(line, "%[C%]") then
                result = result .. line
            end
            line_no = line_no + 1
        end
        return result
    end

    local enum NodeType
        "value"
        "index"
        "key"
    end

    local node_displays: {NodeType: DumpNodeDisplay} = {
        ["value"] = dumper_config.dump.value_display,
        ["index"] = dumper_config.dump.index_display,
        ["key"] = dumper_config.dump.key_display
    }

    local function create_dump(dump_config: DumpDisplayConfig, args: {any}, n: integer): string
        dump_config.table_max_level = dump_config.table_max_level or math.huge
        assert(not dump_config.table_unfold_repeated or dump_config.table_max_level ~= math.huge)

        local function get_glob_var_name(val: any, tab?: {any: any}, recursion_check?: {any: boolean}, is_first_layer?: boolean): string
            tab = tab or _G as {any: any} -- as: the globals table, walked like any table
            recursion_check = recursion_check or {}
            is_first_layer = is_first_layer == nil and true

            for var_name, cur_val in pairs(tab) do
                if cur_val == val then
                    if var_name is number then
                        return "[" .. var_name .. "]"
                    else
                        return (is_first_layer and "" or ".") .. tostring(var_name)
                    end
                elseif cur_val is {any: any} then
                    if recursion_check[cur_val] then
                        return
                    else
                        recursion_check[cur_val] = true
                    end
                    local founding = get_glob_var_name(val, cur_val, recursion_check, false)
                    if founding then
                        if var_name is number then
                            return "[" .. var_name .. "]" .. founding
                        else
                            return (is_first_layer and "" or ".") .. tostring(var_name) .. founding
                        end
                    end
                end
            end
        end

        local function dump_node(val: any, level: integer, node: NodeType, recursion_check?: {any: boolean}): string
            recursion_check = recursion_check or {}

            local indention = dump_config.table_indention and string.rep(dump_config.table_indention, level) or ""
            local value_indention = node == "value" and "" or indention

            local type_ = type(val)
            local var_name: string
            if dump_config.show_global_names then
                var_name = get_glob_var_name(val)
            end
            local content: string

            if val is {any: any} and (dump_config.table_unfold_repeated or not recursion_check[val]) and node == "value" and level < dump_config.table_max_level then
                recursion_check[val] = true
                content = value_indention .. "{" .. dump_config.table_newline
                local last_index = 0
                for key, cur_val in pairs(val) do
                    if key is number and key == last_index + 1 then
                        last_index = key
                        content = content .. dump_node(key, level + 1, "index")
                    else
                        content = content .. dump_node(key, level + 1, "key")
                    end
                    content = content .. dump_node(cur_val, level + 1, "value", recursion_check) .. "," .. dump_config.table_newline
                end
                content = content .. indention .. "}"
            end
            return value_indention .. node_displays[node](val, type_, var_name, content)
        end

        local result = "\n[DUMP]\n"
        for i = 1, n do
            result = result .. dump_node(args[i], 0, "value") .. (i ~= n and dump_config.separator or "")
        end
        return result
    end

    return function(...: any): any
        local result = ""

        if dumper_config.keyword then
            result = result .. create_keyword(dumper_config.keyword)
        end

        if dumper_config.stacktrace then
            result = result .. create_stacktrace(dumper_config.stacktrace)
        end

        if dumper_config.dump then
            local args = {
                ...
            }
            local n = select("#", ...)
            result = result .. create_dump(dumper_config.dump, args, n)
        end

        if dumper_config.text_processor then
            return dumper_config.text_processor(result)
        else
            return result
        end
    end

end

local function _is_identifier(str: string): boolean
    local l = #str
    local b, e = string.find(str, "[%a_][%w_]*")
    return b == 1 and e == l
end

-- Kept as a drop-in `text_processor` replacement for `print` when dumps
-- exceed the console line-length limit.
local function _long_print(str: string)
    local limit = 3000
    local strlen = #str
    for i = 1, strlen, limit do
        local res = string.sub(str, i, i + limit - 1)
        print(res)
    end
end
local _ = _long_print

local default_dump_config: DumpConfig = {
    stacktrace = {},
    dump = {
        show_global_names = false,
        table_max_level = nil,
        table_indention = "    ",
        table_unfold_repeated = false,
        table_newline = "\n",
        index_display = function(_value: any, _type: string, _global_name: string, _content: string): string
            return ""
        end,
        key_display = function(value: any, type_: string, _global_name: string, _content: string): string
            if type_ == "table" or type_ == "userdata" or type_ == "function" or type_ == "thread" then
                return tostring(value)
            elseif value is string then
                if _is_identifier(value) then
                    return value .. " = "
                else
                    return "[\"" .. value .. "\"] = "
                end
            else
                return "[" .. tostring(value) .. "] = "
            end
        end,
        value_display = function(value: any, type_: string, _global_name: string, content: string): string
            if type_ == "table" then
                return content and content or tostring(value)
            elseif type_ == "string" then
                return "\"" .. tostring(value) .. "\""
            else
                return tostring(value)
            end
        end,
        separator = ",\n"
    },
    text_processor = print as function(string): any -- as: print takes the one string
}

dump = _dump_generator(default_dump_config)
