local Utils = require("utils.utils")

local Aabb: Aabb = class("Aabb")

Aabb.init = function(self: Aabb)
    self[1] = math.huge
    self[2] = math.huge
    self[3] = -math.huge
    self[4] = -math.huge
end

function Aabb:get_bounds(): number, number, number, number
    return self[1], self[2], self[3], self[4]
end

function Aabb:get_position_and_size(): number, number, number, number
    return self[1], self[2], self[3] - self[1], self[4] - self[2]
end

function Aabb:set_position_and_size(x: number, y: number, w: number, h: number)
    self[1], self[2], self[3], self[4] = x, y, x + w, y + h
end

function Aabb:get_min_x(): number
    return self[1]
end

function Aabb:get_min_y(): number
    return self[2]
end

function Aabb:get_max_x(): number
    return self[3]
end

function Aabb:get_max_y(): number
    return self[4]
end

function Aabb:add_point(x: number, y: number)
    local min_x, min_y, max_x, max_y = self[1], self[2], self[3], self[4]
    self[1] = math.min(min_x, x)
    self[2] = math.min(min_y, y)
    self[3] = math.max(max_x, x)
    self[4] = math.max(max_y, y)
end

function Aabb:add_aabb(other: Aabb)
    assert_type(other, Aabb)
    local min_x, min_y, max_x, max_y = self[1], self[2], self[3], self[4]
    self[1] = math.min(min_x, other[1])
    self[2] = math.min(min_y, other[2])
    self[3] = math.max(max_x, other[3])
    self[4] = math.max(max_y, other[4])
end

function Aabb:set(other: Aabb)
    self[1] = other[1]
    self[2] = other[2]
    self[3] = other[3]
    self[4] = other[4]
end

function Aabb:reset()
    self[1] = math.huge
    self[2] = math.huge
    self[3] = -math.huge
    self[4] = -math.huge
end

function Aabb:is_point_inside(x: number, y: number): boolean
    local min_x, min_y, max_x, max_y = self[1], self[2], self[3], self[4]
    return x >= min_x and x <= max_x and y >= min_y and y <= max_y
end

function Aabb:get_width(): number
    return self[3] - self[1]
end

function Aabb:get_height(): number
    return self[4] - self[2]
end

function Aabb:is_intersecting(other: Aabb): boolean
    assert_type(other, Aabb)
    local a_min_x, a_min_y, a_max_x, a_max_y = self[1], self[2], self[3], self[4]
    local b_min_x, b_min_y, b_max_x, b_max_y = other[1], other[2], other[3], other[4]
    return a_min_x <= b_max_x and a_max_x >= b_min_x and a_min_y <= b_max_y and a_max_y >= b_min_y
end

function Aabb:get_position(): number, number
    return self[1], self[2]
end

function Aabb:get_size(): number, number
    return self[3] - self[1], self[4] - self[2]
end

function Aabb:is_intersecting_circle(x: number, y: number, r: number): boolean
    if self:is_point_inside(x, y) then
        return true
    end
    local min_x, min_y, max_x, max_y = self[1], self[2], self[3], self[4]
    local cx = Utils.clamp(min_x, max_x, x)
    local cy = Utils.clamp(min_y, max_y, y)
    return (x - cx) * (x - cx) + (y - cy) * (y - cy) <= r * r
end

return Aabb
