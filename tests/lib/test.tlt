local table_utils = require("utils.table")

-- Minimal zero-dependency test framework. Tests are grouped into suites;
-- each case runs in protected mode so one failure never stops the run.
local record Failure
    name: string
    err: string
end

local record TestSuite
    name: string
    passed: integer
    failed: integer
    failures: {Failure}
end

-- any (the assertions): they compare and display values of any type.
local record Test
    suite: function(name: string)
    case: function(name: string, fn: function())
    assert_eq: function(actual: any, expected: any, message?: string)
    assert_true: function(value: any, message?: string)
    assert_false: function(value: any, message?: string)
    -- tolerance defaults to 1e-9
    assert_near: function(actual: number, expected: number, tolerance?: number, message?: string)
    -- Assert that `fn` raises an error.
    assert_error: function(fn: function(), message?: string)
    -- Recursively compare two values (tables by structure, everything else
    -- by equality).
    assert_deep_eq: function(actual: any, expected: any, message?: string)
    -- Print results of all suites and return the total number of failed
    -- cases.
    report: function(): integer
end

local test: Test = {}

local suites: {TestSuite} = {}

local current_suite: TestSuite = nil

-- Start a new suite; subsequent `test.case` calls are recorded under it.
function test.suite(name: string)
    current_suite = {
        name = name,
        passed = 0,
        failed = 0,
        failures = {}
    }
    table.insert(suites, current_suite)
end

-- Run a single test case in protected mode.
function test.case(name: string, fn: function())
    local suite = assert(current_suite, "test.suite() must be called before test.case()")
    -- The message handler keeps the error as text (xpcall's results are
    -- typed by fn's, which has none).
    local err: string
    local ok = xpcall(fn, function(e: any): string -- any: whatever was raised
        err = tostring(e)
        return err
    end)
    if ok then
        suite.passed = suite.passed + 1
    else
        suite.failed = suite.failed + 1
        table.insert(suite.failures, {
            name = name,
            err = err
        })
    end
end

local function _display(value: any): string -- any: see Test
    if value is string then
        return string.format("%q", value)
    end
    return tostring(value)
end

local function _prefix(message: string): string
    return message and (message .. ": ") or ""
end

function test.assert_eq(actual: any, expected: any, message?: string) -- any: see Test
    if actual ~= expected then
        error(string.format("%sexpected %s, got %s", _prefix(message), _display(expected), _display(actual)), 2)
    end
end

function test.assert_true(value: any, message?: string) -- any: see Test
    if not value then
        error(string.format("%sexpected truthy value, got %s", _prefix(message), _display(value)), 2)
    end
end

function test.assert_false(value: any, message?: string) -- any: see Test
    if value then
        error(string.format("%sexpected falsy value, got %s", _prefix(message), _display(value)), 2)
    end
end

function test.assert_near(actual: number, expected: number, tolerance?: number, message?: string)
    tolerance = tolerance or 1e-9
    if math.abs(actual - expected) > tolerance then
        error(string.format("%sexpected %s +/- %s, got %s", _prefix(message), tostring(expected), tostring(tolerance), tostring(actual)), 2)
    end
end

function test.assert_error(fn: function(), message?: string)
    local ok = pcall(fn)
    if ok then
        error(_prefix(message) .. "expected an error, but none was raised", 2)
    end
end

local function _deep_eq(a: any, b: any): boolean -- any: see Test
    if a == b then
        return true
    end
    if not a is {any: any} or not b is {any: any} then -- any: tables of any shape
        return false
    end
    for k, v in pairs(a) do
        if not _deep_eq(v, b[k]) then
            return false
        end
    end
    for k in pairs(b) do
        if a[k] == nil then
            return false
        end
    end
    return true
end

function test.assert_deep_eq(actual: any, expected: any, message?: string) -- any: see Test
    if not _deep_eq(actual, expected) then
        error(string.format("%sdeep equality failed:\n  actual:   %s\n  expected: %s", _prefix(message), table_utils.to_string(actual), table_utils.to_string(expected)), 2)
    end
end

function test.report(): integer
    local total_passed, total_failed = 0, 0
    for _, suite in ipairs(suites) do
        total_passed = total_passed + suite.passed
        total_failed = total_failed + suite.failed
        local status = suite.failed == 0 and "PASS" or "FAIL"
        print(string.format("[%s] %-24s %3d passed, %d failed", status, suite.name, suite.passed, suite.failed))
        for _, failure in ipairs(suite.failures) do
            print(string.format("       * %s\n         %s", failure.name, failure.err))
        end
    end
    print(string.format("Total: %d passed, %d failed", total_passed, total_failed))
    return total_failed
end

return test
