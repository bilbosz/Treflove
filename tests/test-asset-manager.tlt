local test = require("tests.lib.test")
local mocks = require("tests.lib.mocks")
local AssetManager: AssetManager = require("data.asset-manager")
local Connection: Connection = require("networking.connection")

-- What AssetManager needs of a session: a Session by type, with only its
-- connection behind it.
local interface TestSession is Session
end

-- `log` records the session's release and every handler a dying procedure
-- unregisters, with the number of entries the manager still holds for the
-- session at that moment.
local log: {string} = {}
local manager: AssetManager
local session: TestSession

local function count_entries(s: Session): integer
    local n = 0
    -- as: three tables of procedures by session, counted alike
    for _, rps in ipairs({manager._upload_asset_rp as {Session: RemoteProcedure}, manager._download_asset_rp as {Session: RemoteProcedure}, manager._download_missing_assets_rp as {Session: RemoteProcedure}}) do
        if rps[s] ~= nil then
            n = n + 1
        end
    end
    return n
end

local interface TestAssetLoggingConnection is Connection
end

local TestLoggingConnection: TestAssetLoggingConnection = class("TestAssetLoggingConnection", Connection)

function TestLoggingConnection:unregister_request_handler(id: string)
    table.insert(log, "  unregister " .. id .. ", entries " .. count_entries(session))
    Connection.unregister_request_handler(self, id)
end

local TestSession: TestSession = class("TestSession")

TestSession.init = function(self: TestSession, connection: Connection)
    self._connection = connection
end

function TestSession:get_connection(): Connection
    return self._connection
end

function TestSession:release(reason?: LifetimeReason)
    table.insert(log, "TestSession:release(" .. tostring(reason) .. "), entries " .. count_entries(self))
end

test.suite("AssetManager")

test.case("a session's procedures die with it, newest first, after its entries are gone", function()
    mocks.install_app()
    mocks.ensure_love_data()
    local connection = TestLoggingConnection(mocks.make_channel(), mocks.make_thread(), mocks.make_channel(), mocks.make_thread())
    manager = AssetManager()
    session = TestSession(connection)
    manager:register_session(session)
    local procedures: {RemoteProcedure} = {manager._upload_asset_rp[session], manager._download_asset_rp[session], manager._download_missing_assets_rp[session]}
    log = {}

    lifetime.destroy(session)

    -- lua-lifetime docs/02-semantics.md, "Cascading death": the session's
    -- body first; then its dependents, newest first: the hook that removes
    -- the entries (attached last), then the three procedures.
    test.assert_deep_eq(log, {
        "TestSession:release(destroy), entries 3",
        "  unregister DownloadMissingAssetsRp, entries 0",
        "  unregister DownloadAssetRp, entries 0",
        "  unregister UploadAssetRp, entries 0"
    })
    for _, rp in ipairs(procedures) do
        test.assert_false(lifetime.alive(rp))
    end
    -- as: tl rejects `next` on these maps (`in map key: got <any type>`);
    -- the emptiness check is the same on any table
    test.assert_eq(next(manager._upload_asset_rp as {any: any}), nil)
    test.assert_eq(next(manager._download_asset_rp as {any: any}), nil)
    test.assert_eq(next(manager._download_missing_assets_rp as {any: any}), nil)
    test.assert_true(lifetime.alive(connection), "the connection does not depend on the session")
end)
