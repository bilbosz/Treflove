local Control: Control = require("controls.control")

-- A full-screen UI container: its root control is put under `app.root` while
-- the ScreenManager shows it. What owns a screen object and who destroys it:
-- docs/lifetime.md, "Screens".
local Screen: Screen = class("Screen")

Screen.init = function(self: Screen)
    self.screen = Control()
end

function Screen:show()
    assert(not self.screen:get_parent())
    self.screen:set_parent(app.root)
end

function Screen:hide()
    assert(self.screen:get_parent())
    self.screen:set_parent(nil)
end

function Screen:on_resize(_w: number, _h: number)
end

function Screen:get_control(): Control
    return self.screen
end

return Screen
