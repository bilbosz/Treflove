local Control: Control = require("controls.control")

-- A filled or outlined rectangle.
local Rectangle: Rectangle = class("Rectangle", Control)

Rectangle.init = function(self: Rectangle, parent: Control, width: number, height: number, color?: {number}, border_only?: boolean)
    assert(width and height)
    Control.init(self, parent, width, height)
    self._color = color or {
        1,
        1,
        1,
        1
    }
    self._mode = border_only and "line" or "fill"
end

function Rectangle:set_color(color: {number})
    self._color = color
end

function Rectangle:get_color(): {number}
    return self._color
end

function Rectangle:draw()
    love.graphics.push()
    -- The table variant: tl miscounts `table.unpack` of a {number} as two
    -- arguments; LÖVE sets the same color from {r, g, b[, a]}.
    love.graphics.setColor(self._color)
    do
        love.graphics.replaceTransform(self.global_transform)
        love.graphics.rectangle(self._mode, 0, 0, table.unpack(self.size))
    end
    love.graphics.setColor(1, 1, 1, 1)
    love.graphics.pop()
    Control.draw(self)
end

return Rectangle
