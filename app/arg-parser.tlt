require("utils.class")

local arg_parser: ArgParser = {}

-- The app type, or nil when the string is wrong.
local function _parse_app_type(str: string): AppType
    if str == "server" then
        return "server"
    elseif str == "client" then
        return "client"
    end
    return nil
end

-- The input string, or nil when it is not an address.
local function _parse_address(str: string): string
    if str == "localhost" then
        return str
    else
        local pattern = "(%d+)%.(%d+)%.(%d+)%.(%d+)"
        local findings = {
            string.find(str, pattern)
        }
        if #findings ~= 6 then
            return nil
        end
        for i = 3, 6 do
            local v = findings[i]
            local num = tonumber(v)
            if not num or num < 0 or num > 255 then
                return nil
            end
        end
        return str
    end
end

-- The input string, or nil when it is not a port number.
local function _parse_port(str: string): string
    local num = tonumber(str)
    return num and num >= 1024 and num <= 65535 and str or nil
end

function arg_parser.parse(args: {string}): ArgParserResult
    if #args < 4 then
        return nil
    else
        local app_type, address, port = _parse_app_type(args[2]), _parse_address(args[3]), _parse_port(args[4])
        if not app_type or not address or not port then
            return nil
        end
        return {
            app_type = app_type,
            address = address,
            port = port
        }
    end
end

return arg_parser
