-- https://luacheck.readthedocs.io/en/stable/index.html
max_line_length = false
max_comment_line_length = false

-- 212 (unused argument): event handlers and callback tables keep their full
-- parameter lists as API documentation even when a body ignores them
ignore = {"212"}

std = {
    read_globals = {
        "_G",
        "arg",
        "assert",
        "collectgarbage",
        "debug",
        "error",
        "getmetatable",
        "io",
        "ipairs",
        "loadstring",
        "math",
        "next",
        "os",
        "pairs",
        "pcall",
        "print",
        "rawget",
        "rawset",
        "require",
        "select",
        "setmetatable",
        "string",
        "table",
        "tonumber",
        "tostring",
        "type",
        "unpack",
        "xpcall",
    },

    globals = {
        "abstract",
        "app",
        -- tests/run.lua installs a socket stub via package.preload
        "package",
        "assert_type",
        "assert_unreachable",
        "cipairs",
        "class",
        "config",
        "cpairs",
        "cripairs",
        "dump",
        "get_class_name_of",
        "get_class_of",
        "is_instance_of",
        "love",
        "prev",
        "ripairs",
        "toboolean",
    }
}

-- `lifetime` is not a global: Lua files require it (`local lifetime =
-- require("lifetime")`), generated code binds it in its header.
exclude_files = {
    "doc/**",
    -- generated by ./build-code.sh
    "build/**",
    -- submodules (lua-lifetime, tl, love-api)
    "lib/**",
    -- a tool's own tree (editor state, agent worktrees)
    ".claude/**"
}
