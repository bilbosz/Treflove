-- https://luacheck.readthedocs.io/en/stable/index.html
-- (For the Lua language server, which reads this file as Lua: a luacheck
-- config is made of global assignments, and `files` is luacheck's table.)
---@diagnostic disable: lowercase-global, undefined-global
max_line_length = false
max_comment_line_length = false

-- 212 (unused argument): event handlers and callback tables keep their full
-- parameter lists as API documentation even when a body ignores them
ignore = {"212"}

std = {
    read_globals = {
        "_G",
        "arg",
        "assert",
        "collectgarbage",
        "coroutine",
        "debug",
        "dofile",
        "error",
        "getmetatable",
        "io",
        "ipairs",
        "loadfile",
        "loadstring",
        "math",
        "next",
        "os",
        "pairs",
        "pcall",
        "print",
        "rawget",
        "rawset",
        "require",
        "select",
        "setmetatable",
        "string",
        "table",
        "tonumber",
        "tostring",
        "type",
        "unpack",
        "xpcall",
    },

    -- What the Lua files (main.lua, conf.lua, tests/run.lua, tools/,
    -- .vscode/launch.lua, editor/) use beyond the standard library; the
    -- Teal modules are checked by ./build-code.sh.
    globals = {
        "assert_unreachable",
        -- conf.lua keeps LÖVE's configuration table
        "config",
        "love",
        -- tests/run.lua installs a socket stub via package.preload
        "package"
    }
}

files["editor/luals/plugin.lua"] = {
    -- The language server's plugin (docs/development.md, "Editor
    -- Support"): OnSetText is the global the server looks up; log is the
    -- server's logger.
    globals = {"OnSetText"},
    read_globals = {"log"}
}

files["editor/luals/check.lua"] = {
    -- Runs under Lua 5.1 (setfenv) and the server's Lua 5.4 (load).
    read_globals = {"setfenv", "load"}
}

-- `lifetime` is not a global: the code the transpiler generates binds it
-- in its header (`local lifetime = require("lifetime")`).
exclude_files = {
    -- generated by ./build-code.sh
    "build/**",
    -- submodules (lua-lifetime, tl, love-api)
    "lib/**"
}
