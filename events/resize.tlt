local Event = require("events.event")

-- Tracks the window size and fullscreen state. Consumers register on the
-- `resized` event: `app.resize_manager.resized:register(self, self.on_resize)`.
local ResizeManager: ResizeManager = class("ResizeManager")

function ResizeManager:_update_non_fs_size()
    if not self:get_fullscreen() then
        self._width, self._height = self:get_dimensions()
    end
end

ResizeManager.init = function(self: ResizeManager)
    self._width = config.window.width or 0
    self._height = config.window.height or 0
    self:_update_non_fs_size()
    self.resized = Event()
end

function ResizeManager:resize()
    self:_update_non_fs_size()
    app:rescale_root()
    self.resized:trigger(app.width, app.height)
end

function ResizeManager:get_dimensions(): number, number
    return love.graphics.getDimensions()
end

function ResizeManager:toggle_fullscreen()
    self:set_fullscreen(not self:get_fullscreen())
end

function ResizeManager:set_fullscreen(value: boolean)
    love.window.updateMode(self._width, self._height, {
        fullscreen = value,
        fullscreentype = "desktop"
    })
    self:resize()
end

function ResizeManager:get_fullscreen(): boolean
    return (love.window.getFullscreen())
end

return ResizeManager
