{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format All Code",
            "type": "shell",
            "command": "./format-code.sh"
        },
        {
            "label": "Run Server + Client",
            "type": "shell",
            "command": "./run.sh",
            "problemMatcher": []
        },
        {
            // After a Client session: the server the debugger launched (the one with the debugger's variable in
            // its environment; a server started from a shell stays), since the compound's stopAll acts only on a
            // manual stop
            "label": "Stop the debugged server",
            "type": "shell",
            "command": "for p in $(pgrep -f 'love \\. server localhost 8080'); do tr '\\0' '\\n' < /proc/$p/environ 2>/dev/null | grep -qx LOCAL_LUA_DEBUGGER_VSCODE=1 && kill $p; done; true",
            "presentation": {
                "reveal": "never",
                "close": true
            },
            "problemMatcher": []
        },
        {
            // The server of the Scenario (headless) launch configuration: its own port, identity and fixture, a
            // console for the scenario's server calls; detached, so the task ends while the server lives
            "label": "Start the scenario server",
            "type": "shell",
            "command": "mkdir -p /tmp/treflove-scenario && setsid love . server localhost 8181 --identity treflove-scenario --fixture scenarios/fixtures/basic --console 9091 > /tmp/treflove-scenario/debug-server.log 2>&1 < /dev/null & disown; sleep 1; true",
            "presentation": {
                "reveal": "never",
                "close": true
            },
            "problemMatcher": []
        },
        {
            // By the process name and the identity, so neither the task's shell nor the user's own server matches
            "label": "Stop the scenario server",
            "type": "shell",
            "command": "for p in $(pgrep -x love); do tr '\\0' ' ' < /proc/$p/cmdline 2>/dev/null | grep -q -- '--identity treflove-scenario' && kill $p; done; true",
            "presentation": {
                "reveal": "never",
                "close": true
            },
            "problemMatcher": []
        }
    ]
}
