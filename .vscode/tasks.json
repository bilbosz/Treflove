{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            // ./build-code.sh: transpile, type-check and generate into
            // build/. Its errors read FILE:LINE:COL: message (relative to
            // the root), which the matcher turns into Problems entries. The
            // "Debug ..." configurations of launch.json run it first.
            "label": "Build",
            "type": "shell",
            "command": "./build-code.sh",
            "group": "build",
            "problemMatcher": {
                "owner": "treflove",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+): (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            // ./format-code.sh: lua-format over the Lua files (.lua-format).
            "label": "Format Lua files",
            "type": "shell",
            "command": "./format-code.sh",
            "problemMatcher": []
        }
    ]
}
