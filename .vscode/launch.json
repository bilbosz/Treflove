{
    // Run and Debug (F5): the program under the Local Lua Debugger
    // (ismoh-games.second-local-lua-debugger-vscode), see docs/development.md
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Client",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [".", "client", "localhost", "8080", "--scenario", "join-game", "--console", "9090", "--server-console", "9091"],
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false,
            "postDebugTask": "Stop the debugged server"
        },
        {
            "name": "Client (login screen)",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [".", "client", "localhost", "8080", "--console", "9090", "--server-console", "9091"],
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false
        },
        {
            "name": "Server",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [".", "server", "localhost", "8080", "--console", "9091"],
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false
        },
        {
            "name": "Monitor",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [".", "monitor", "127.0.0.1", "client:9090,server:9091"],
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false
        },
        {
            "name": "Scenario (headless)",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [".", "client", "localhost", "8181", "--identity", "treflove-scenario", "--scenario", "${input:scenario}", "--headless", "--console", "9090", "--server-console", "9091"],
            "env": {
                "SDL_VIDEODRIVER": "offscreen",
                "SDL_AUDIODRIVER": "dummy"
            },
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false,
            "preLaunchTask": "Start the scenario server",
            "postDebugTask": "Stop the scenario server"
        },
        {
            "name": "Tests (LuaJIT)",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "luajit"
            },
            "args": ["tests/run.lua"],
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false
        },
        {
            "name": "Tests (LÖVE)",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [".", "test"],
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false
        }
    ],
    "compounds": [
        {
            "name": "Server + Client",
            "configurations": ["Server", "Client"],
            "stopAll": true
        }
    ],
    "inputs": [
        {
            "id": "scenario",
            "type": "promptString",
            "description": "The scenario to run (a file under scenarios/)",
            "default": "join-game"
        }
    ]
}
