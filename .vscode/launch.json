{
    // Run and Debug (F5): the program under the Local Lua Debugger
    // (ismoh-games.second-local-lua-debugger-vscode), see docs/development.md
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Client",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [".", "client", "localhost", "8080"],
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false,
            "postDebugTask": "Stop the debugged server"
        },
        {
            "name": "Server",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [".", "server", "localhost", "8080"],
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false
        },
        {
            "name": "Tests (LuaJIT)",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "luajit"
            },
            "args": ["tests/run.lua"],
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false
        },
        {
            "name": "Tests (LÖVE)",
            "type": "lua-local",
            "request": "launch",
            "program": {
                "command": "love"
            },
            "args": [".", "test"],
            "scriptRoots": ["${workspaceFolder}"],
            "breakInProtectedCalls": false
        }
    ],
    "compounds": [
        {
            "name": "Server + Client",
            "configurations": ["Server", "Client"],
            "stopAll": true
        }
    ]
}
